lab-com/image/upload/f_auto,q_auto,w_318,c_lfill/v1749661926/Blog/Hero%20Images/security-patch-blog-image-r2-0506-700x400-fy25_2x.jpg\" data-v-4d3fff66=\"\"><h3 class=\"slp-text-heading5-bold\" data-v-64ad2128=\"\" data-v-4d3fff66=\"\"><!--[-->GitLab Patch Release: 18.4.2, 18.3.4, 18.2.8<!--]--><!----></h3><p class=\"slp-text-body1\" data-v-64ad2128=\"\" data-v-4d3fff66=\"\"><!--[-->Learn more about GitLab Patch Release: 18.4.2, 18.3.4, 18.2.8 for GitLab Community Edition (CE) and Enterprise Edition (EE).<!--]--><!----></p></a>","link":"https://about.gitlab.com/releases/2025/10/08/patch-release-gitlab-18-4-2-released/","retrieved":1764672387841},{"title":"A comprehensive guide to GitLab DAST","contents":"<a href=\"/blog/categories/security/\" data-ga-name=\"security\" data-ga-location=\"post-card\" data-v-4d3fff66=\"\"><span class=\"slp-text-body1\" data-v-64ad2128=\"\" data-v-4d3fff66=\"\"><!--[-->Security<!--]--><!----></span></a><a href=\"/blog/comprehensive-guide-to-gitlab-dast/\" class=\"card-body\" data-ga-name=\"a comprehensive guide to gitlab dast\" data-ga-location=\"post-card\" data-v-4d3fff66=\"\"><img width=\"318\" data-nuxt-img=\"\" srcset=\"https://res.cloudinary.com/about-gitlab-com/image/upload/f_auto,q_auto,w_318,c_lfill/v1759320418/xjmqcozxzt4frx0hori3.png 1x, https://res.cloudinary.com/about-gitlab-com/image/upload/f_auto,q_auto,w_636,c_lfill/v1759320418/xjmqcozxzt4frx0hori3.png 2x\" onerror=\"this.setAttribute('data-error', 1)\" loading=\"lazy\" alt=\"\" src=\"https://res.cloudinary.com/about-gitlab-com/image/upload/f_auto,q_auto,w_318,c_lfill/v1759320418/xjmqcozxzt4frx0hori3.png\" data-v-4d3fff66=\"\"><h3 class=\"slp-text-heading5-bold\" data-v-64ad2128=\"\" data-v-4d3fff66=\"\"><!--[-->A comprehensive guide to GitLab DAST<!--]--><!----></h3><p class=\"slp-text-body1\" data-v-64ad2128=\"\" data-v-4d3fff66=\"\"><!--[-->DevSecOps teams can learn how to implement and configure dynamic application security testing, perform passive/active scans, and set security policies.<!--]--><!----></p></a>","link":"https://about.gitlab.com/blog/comprehensive-guide-to-gitlab-dast/","retrieved":1764672387843},{"title":"A developer's guide to building secure retail apps with GitLab","contents":"<a href=\"/blog/categories/security/\" data-ga-name=\"security\" data-ga-location=\"post-card\" data-v-4d3fff66=\"\"><span class=\"slp-text-body1\" data-v-64ad2128=\"\" data-v-4d3fff66=\"\"><!--[-->Security<!--]--><!----></span></a><a href=\"/blog/a-developers-guide-to-building-secure-retail-apps-with-gitlab/\" class=\"card-body\" data-ga-name=\"a developer's guide to building secure retail apps with gitlab\" data-ga-location=\"post-card\" data-v-4d3fff66=\"\"><img width=\"318\" data-nuxt-img=\"\" srcset=\"https://res.cloudinary.com/about-gitlab-com/image/upload/f_auto,q_auto,w_318,c_lfill/v1756989645/fojzxakmfdea6jfqjkrl.png 1x, https://res.cloudinary.com/about-gitlab-com/image/upload/f_auto,q_auto,w_636,c_lfill/v1756989645/fojzxakmfdea6jfqjkrl.png 2x\" onerror=\"this.setAttribute('data-error', 1)\" loading=\"lazy\" alt=\"\" src=\"https://res.cloudinary.com/about-gitlab-com/image/upload/f_auto,q_auto,w_318,c_lfill/v1756989645/fojzxakmfdea6jfqjkrl.png\" data-v-4d3fff66=\"\"><h3 class=\"slp-text-heading5-bold\" data-v-64ad2128=\"\" data-v-4d3fff66=\"\"><!--[-->A developer's guide to building secure retail apps with GitLab<!--]--><!----></h3><p class=\"slp-text-body1\" data-v-64ad2128=\"\" data-v-4d3fff66=\"\"><!--[-->Learn how a DevSecOps platform helps retailers develop secure, compliant software for complex, high-traffic retail environments.<!--]--><!----></p></a>","link":"https://about.gitlab.com/blog/a-developers-guide-to-building-secure-retail-apps-with-gitlab/","retrieved":1764672387844},{"title":"GitLab uncovers Bittensor theft campaign via PyPI","contents":"<a href=\"/blog/categories/security/\" data-ga-name=\"security\" data-ga-location=\"post-card\" data-v-4d3fff66=\"\"><span class=\"slp-text-body1\" data-v-64ad2128=\"\" data-