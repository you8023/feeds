ading="lazy" src="https://cdn.prod.website-files.com/68a48e5a6b74c275276a3f5d/6903200e83b4ec8c10396482_Screenshot%202025-10-30%20at%2010.20.42.jpg" alt="" sizes="100vw" srcset="https://cdn.prod.website-files.com/68a48e5a6b74c275276a3f5d/6903200e83b4ec8c10396482_Screenshot%202025-10-30%20at%2010.20.42-p-500.jpg 500w, https://cdn.prod.website-files.com/68a48e5a6b74c275276a3f5d/6903200e83b4ec8c10396482_Screenshot%202025-10-30%20at%2010.20.42.jpg 791w" class="blog_author-image"></div><div class="blog_author_text-wrapper"><div class="blog_author-text"><div class="text-size-small text-weight-semibold text-color-secondary">Yuval Lazar</div><div class="text-size-small text-color-secondary">Head of Security Research</div></div><div class="text-size-small text-color-secondary">Oct 30, 2025</div></div></div></div></div></a><link rel="prefetch" href="/blog/unused-secrets-the-loaded-guns-in-your-infrastructure-2">]]></content>
