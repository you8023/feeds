{"title":"Daniele Antonioli Blog","url":"https://francozappa.github.io/","favicon":"https://francozappa.github.io/media/icon_hufd6449924b8771808a89b636be1cd7b0_295644_32x32_fill_lanczos_center_3.png","elements":[{"title":"CTRAPS on the DEF CON 33 Hackers' Almanack","contents":"<div class=\"media-body\">\n\n    <div class=\"section-subheading article-title mb-0 mt-0\">\n      <a href=\"/post/2026/defcon-almanack/\">CTRAPS on the DEF CON 33 Hackers' Almanack</a>\n    </div>\n\n    \n    <a href=\"/post/2026/defcon-almanack/\" class=\"summary-link\">\n      <div class=\"article-style\">\n        The DEF CON 33 Hackers’ Almanack just dropped. We would like to thank Paul Chang and their team for featuring CTRAPS in the Right to Repair section. Read and share the Almanack!\n      </div>\n    </a>\n    \n\n    <div class=\"stream-meta article-metadata\">\n\n      \n\n      \n        \n\n\n<div class=\"article-metadata\">\n\n  \n  \n\n  \n  <span class=\"article-date\">\n    \n    \n      \n    \n    Feb 14, 2026\n  </span>\n  \n\n  \n\n  \n  <span class=\"middot-divider\"></span>\n  <span class=\"article-reading-time\">\n    1 min read\n  </span>\n  \n\n  \n  \n  \n  \n  \n  \n    <span class=\"middot-divider\"></span>\n    <a href=\"/post/2026/defcon-almanack/#disqus_thread\"></a>\n  \n\n  \n  \n\n</div>\n\n      \n    </div>\n\n    \n\n  </div>\n  <div class=\"ml-3\">\n    \n    \n    \n    <a href=\"/post/2026/defcon-almanack/\">\n      <img src=\"/post/2026/defcon-almanack/featured_huc158944144f054252ca68111c023b017_258775_150x0_resize_q75_h2_lanczos.webp\" height=\"142\" width=\"150\" alt=\"CTRAPS on the DEF CON 33 Hackers' Almanack\" loading=\"lazy\">\n    </a>\n    \n  </div>","link":"https://francozappa.github.io/post/2026/defcon-almanack/","retrieved":1771027200000},{"title":"CTRAPS interview on Off By One Security","contents":"<div class=\"media-body\">\n\n    <div class=\"section-subheading article-title mb-0 mt-0\">\n      <a href=\"/post/2025/ctraps-offbyone/\">CTRAPS interview on Off By One Security</a>\n    </div>\n\n    \n    <a href=\"/post/2025/ctraps-offbyone/\" class=\"summary-link\">\n      <div class=\"article-style\">\n        Marco and I talked about CTRAPS with Stephen Sims from Off By One Security about CTRAPS: CTAP Impersonation and API Confusion on FIDO2.\nThank you Stephen and Randall for inviting us and keep up with the awesome content in your YouTube channel!\n      </div>\n    </a>\n    \n\n    <div class=\"stream-meta article-metadata\">\n\n      \n\n      \n        \n\n\n<div class=\"article-metadata\">\n\n  \n  \n\n  \n  <span class=\"article-date\">\n    \n    \n      \n    \n    Sep 22, 2025\n  </span>\n  \n\n  \n\n  \n  <span class=\"middot-divider\"></span>\n  <span class=\"article-reading-time\">\n    1 min read\n  </span>\n  \n\n  \n  \n  \n  \n  \n  \n    <span class=\"middot-divider\"></span>\n    <a href=\"/post/2025/ctraps-offbyone/#disqus_thread\">0 Comments</a>\n  \n\n  \n  \n\n</div>\n\n      \n    </div>\n\n    \n\n  </div>\n  <div class=\"ml-3\">\n    \n    \n    \n    <a href=\"/post/2025/ctraps-offbyone/\">\n      <img src=\"/post/2025/ctraps-offbyone/featured_hu91bf7adc65ac960e7827b9cbc1d4e4d5_10695_150x0_resize_q75_h2_lanczos.webp\" height=\"154\" width=\"150\" alt=\"CTRAPS interview on Off By One Security\" loading=\"lazy\">\n    </a>\n    \n  </div>","link":"https://francozappa.github.io/post/2025/ctraps-offbyone/","retrieved":1758499200000},{"title":"CTRAPS at Euro S&P'25 and DEF CON 33","contents":"<div class=\"media-body\">\n\n    <div class=\"section-subheading article-title mb-0 mt-0\">\n      <a href=\"/post/2025/ctraps-eurosp25/\">CTRAPS at Euro S&amp;P'25 and DEF CON 33</a>\n    </div>\n\n    \n    <a href=\"/post/2025/ctraps-eurosp25/\" class=\"summary-link\">\n      <div class=\"article-style\">\n        This week we presented at IEEE Euro S&amp;P'25 CTRAPS: CTAP Impersonation and API Confusion on FIDO2, a paper about the security and privacy of FIDO2, a widespread standard used for single-factor and multi-factor authentication.\n      </div>\n    </a>\n    \n\n    <div class=\"stream-meta article-metadata\">\n\n      \n\n      \n        \n\n\n<div class=\"article-metadata\">\n\n  \n  \n\n  \n  <span class=\"article-date\">\n    \n    \n      \n    \n    Jul 4, 2025\n  </span>\n  \n\n  \n\n  \n  <span class=\"middot-divider\"></span>\n  <span class=\"article-reading-time\">\n    2 min read\n  </span>\n  \n\n  \n  \n  \n  \n  \n  \n    <span class=\"middot-divider\"></span>\n    <a href=\"/post/2025/ctraps-eurosp25/#disqus_thread\">0 Comments</a>\n  \n\n  \n  \n\n</div>\n\n      \n    </div>\n\n    \n\n  </div>\n  <div class=\"ml-3\">\n    \n    \n    \n    <a href=\"/post/2025/ctraps-eurosp25/\">\n      <img src=\"/post/2025/ctraps-eurosp25/featured_hu87215b816811178d8250c3c2498c641d_16886_150x0_resize_q75_h2_lanczos.webp\" height=\"144\" width=\"150\" alt=\"CTRAPS at Euro S&amp;P'25 and DEF CON 33\" loading=\"lazy\">\n    </a>\n    \n  </div>","link":"https://francozappa.github.io/post/2025/ctraps-eurosp25/","retrieved":1751587200000},{"title":"NDSS'26 Artifact Evaluation Comitee Self-Nomination","contents":"<div class=\"media-body\">\n\n    <div class=\"section-subheading article-title mb-0 mt-0\">\n      <a href=\"/post/2025/ae-ndss26/\">NDSS'26 Artifact Evaluation Comitee Self-Nomination</a>\n    </div>\n\n    \n    <a href=\"/post/2025/ae-ndss26/\" class=\"summary-link\">\n      <div class=\"article-style\">\n        Mathy Vanhoef and I are co-chairing NDSS'26 Artifact Evaluation (AE).\nWe are looking for motivated PhD and Postdocs to self-nominate themselves for the NDSS'26 Artifact Evaluation Committee (AEC). Joining it would offer them practical experience and may ease developing artifact submissions for their papers.\n      </div>\n    </a>\n    \n\n    <div class=\"stream-meta article-metadata\">\n\n      \n\n      \n        \n\n\n<div class=\"article-metadata\">\n\n  \n  \n\n  \n  <span class=\"article-date\">\n    \n    \n      \n    \n    Jun 13, 2025\n  </span>\n  \n\n  \n\n  \n  <span class=\"middot-divider\"></span>\n  <span class=\"article-reading-time\">\n    1 min read\n  </span>\n  \n\n  \n  \n  \n  \n  \n  \n    <span class=\"middot-divider\"></span>\n    <a href=\"/post/2025/ae-ndss26/#disqus_thread\">0 Comments</a>\n  \n\n  \n  \n\n</div>\n\n      \n    </div>\n\n    \n\n  </div>\n  <div class=\"ml-3\">\n    \n    \n  </div>","link":"https://francozappa.github.io/post/2025/ae-ndss26/","retrieved":1749772800000},{"title":"KNOB Attack and Crypto 101 by Alfred Menezes","contents":"<div class=\"media-body\">\n\n    <div class=\"section-subheading article-title mb-0 mt-0\">\n      <a href=\"/post/2025/crypto101-knob/\">KNOB Attack and Crypto 101 by Alfred Menezes</a>\n    </div>\n\n    \n    <a href=\"/post/2025/crypto101-knob/\" class=\"summary-link\">\n      <div class=\"article-style\">\n        Alfred Menezes has published a fantastic online course on real-world cryptography called Crypto 101: Real-World Deployments.\nIt is an honor to be featured in the Bluetooth Security Lecture (Lecture 4) which talks about the KNOB attack.\n      </div>\n    </a>\n    \n\n    <div class=\"stream-meta article-metadata\">\n\n      \n\n      \n        \n\n\n<div class=\"article-metadata\">\n\n  \n  \n\n  \n  <span class=\"article-date\">\n    \n    \n      \n    \n    Apr 1, 2025\n  </span>\n  \n\n  \n\n  \n  <span class=\"middot-divider\"></span>\n  <span class=\"article-reading-time\">\n    1 min read\n  </span>\n  \n\n  \n  \n  \n  \n  \n  \n    <span class=\"middot-divider\"></span>\n    <a href=\"/post/2025/crypto101-knob/#disqus_thread\">0 Comments</a>\n  \n\n  \n  \n\n</div>\n\n      \n    </div>\n\n    \n\n  </div>\n  <div class=\"ml-3\">\n    \n    \n    \n    <a href=\"/post/2025/crypto101-knob/\">\n      <img src=\"/post/2025/crypto101-knob/featured_hu219143e871a86be9bdf92338e7cb739a_31425_150x0_resize_q75_h2_lanczos.webp\" height=\"159\" width=\"150\" alt=\"KNOB Attack and Crypto 101 by Alfred Menezes\" loading=\"lazy\">\n    </a>\n    \n  </div>","link":"https://francozappa.github.io/post/2025/crypto101-knob/","retrieved":1743465600000}]}