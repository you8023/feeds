        <content type="html"><![CDATA[<div class="resources_card"><div data-animate="slide-in" data-clip-sq="tl tr bl br" class="resources_card-visual-w" style=""><img src="https://cdn.prod.website-files.com/6a5f29615015defef7c9471f/6a968d087033ad741dc176d1_Introducing%20Policy%20Tester-1.avif" loading="lazy" alt="" sizes="100vw" srcset="https://cdn.prod.website-files.com/6a5f29615015defef7c9471f/6a968d087033ad741dc176d1_Introducing%20Policy%20Tester-1-p-500.avif 500w, https://cdn.prod.website-files.com/6a5f29615015defef7c9471f/6a968d087033ad741dc176d1_Introducing%20Policy%20Tester-1-p-800.avif 800w, https://cdn.prod.website-files.com/6a5f29615015defef7c9471f/6a968d087033ad741dc176d1_Introducing%20Policy%20Tester-1.avif 810w" class="img_abs is-resources"></div><div class="resources_card-text"><div class="heading-with-p is-16 is-left is-grow"><div class="heading-with-p is-8 is-left"><div class="heading-with-p is-6 is-left"><div data-animate="slide-in" style="background-color: rgb(127, 197, 248); color: rgb(52, 12, 5);" class="resources_tag"><div fs-list-field="category">Blog</div></div><h3 fs-list-field="title" data-animate="slide-in" class="heading-style-h4 text-weight-normal" style="">Introducing IAM Test, a test harness for AWS IAM Policies</h3></div><p fs-list-field="description" data-animate="slide-in" class="text-body text-style-2lines" style="">Say goodbye to trial-and-error deployments. Use IAM Test to evaluate your IAM policy logic entirely client-side, right before you deploy.</p></div><div data-animate="slide-in" class="resources_author-w" style=""><div fs-list-field="author" class="text-caption text-color-grey-medium">David Kerber</div><div fs-list-field="date" class="text-caption text-color-disabled-grey">September 2, 2026</div></div></div></div><a aria-label="Read more" href="/resources/introducing-iam-simulate-a-test-harness-for-aws-iam-policies" class="link_abs w-inline-block"></a></div>]]></content>
