,0,1)]"><span class="font-black text-black text-sm">#<!-- -->HTML Sanitization</span></div><div style="transform:rotate(-2deg)" class="bg-white border-3 border-black px-4 py-1 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]"><span class="font-black text-black text-sm">#<!-- -->htmlparser2</span></div></div></div><div class="flex-shrink-0 bg-pink-400 border-4 border-black w-14 h-14 flex items-center justify-center group-hover:scale-110 group-hover:rotate-12 transition-all shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] cursor-pointer"><span class="text-black font-black text-2xl">→</span></div></div><svg class="absolute bottom-4 left-8 right-8 h-2" viewBox="0 0 400 10"><path d="M 0 5 Q 100 8, 200 5 T 400 5" stroke="currentColor" stroke-width="2" fill="none" class="text-white/10" stroke-linecap="round"></path></svg>]]></content>
